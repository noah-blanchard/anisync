# URL publique de l'application (sans slash final). Sert à construire les redirect URIs OAuth.
APP_URL=http://localhost:3000

# Mot de passe de connexion (utilisateur unique)
APP_PASSWORD=change-me

# Secret >= 32 caractères : signe la session et chiffre les tokens au repos.
# Générer avec : openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# MyAnimeList : https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
# Optionnel : présent pour une app de type "web", absent pour le type "other"
MAL_CLIENT_SECRET=

# AniList : https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# TMDB (optionnel : recherche de séries et de films, affiches, épisodes) : https://www.themoviedb.org/settings/api
# Clé d'API v3 ou jeton d'accès en lecture v4 (commence par "eyJ"). Sans clé, seuls les anime sont proposés.
TMDB_API_KEY=

# Emplacement de la base SQLite (/data/anisync.db en production)
DATABASE_PATH=./data/anisync.db
